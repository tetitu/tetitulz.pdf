<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- System.Net.Http and System.Text.RegularExpressions were pinned here for
         GHSA-7jgj-8wvc-jh57 / GHSA-cmhx-cq75-c4mj; on net10.0 both live in the shared framework,
         so the package reference was redundant (NU1510) — the framework assembly is what loads
         either way, and the out-of-band package cannot re-enter the graph. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\features\Tetitulz.Pdf.HtmlToPdf\Tetitulz.Pdf.HtmlToPdf.csproj" />
    <!-- Test-only: lets the SVG integration test wire the real Base SvgRasterizer. The product
         assembly (Tetitulz.Pdf.HtmlToPdf) deliberately does NOT reference Base. -->
    <ProjectReference Include="..\..\src\tetitulz.pdf\Tetitulz.Pdf.Base\Tetitulz.Pdf.Base.csproj" />
    <ProjectReference Include="..\Tetitulz.Pdf.TestHelpers\Tetitulz.Pdf.TestHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
