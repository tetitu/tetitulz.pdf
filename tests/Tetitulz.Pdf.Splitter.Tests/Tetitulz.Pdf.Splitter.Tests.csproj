<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- The app is a net48 window; its window-free files are compiled in here, as the tray app
       compiles the console printer's. -->
  <ItemGroup>
    <Compile Include="..\..\apps\Tetitulz.Pdf.Splitter\PageRangeText.cs" Link="App\PageRangeText.cs" />
    <Compile Include="..\..\apps\Tetitulz.Pdf.Splitter\SplitJob.cs" Link="App\SplitJob.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\tetitulz.pdf\Tetitulz.Pdf.Base\Tetitulz.Pdf.Base.csproj" />
    <ProjectReference Include="..\..\src\tetitulz.pdf\Tetitulz.Pdf.Encryption\Tetitulz.Pdf.Encryption.csproj" />
    <ProjectReference Include="..\..\src\plugins\Tetitulz.Pdf.Plugins.PageEdits\Tetitulz.Pdf.Plugins.PageEdits.csproj" />
    <ProjectReference Include="..\Tetitulz.Pdf.TestHelpers\Tetitulz.Pdf.TestHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
