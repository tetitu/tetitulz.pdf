<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Security: override a vulnerable transitive Newtonsoft.Json (GHSA-5crp-9r3c-p9vr).
         System.Net.Http and System.Text.RegularExpressions were pinned alongside it for
         GHSA-7jgj-8wvc-jh57 / GHSA-cmhx-cq75-c4mj; on net10.0 both live in the shared framework,
         so the package reference was redundant (NU1510) — the framework assembly is what loads
         either way, and the out-of-band package cannot re-enter the graph. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\features\Tetitulz.Pdf.DocxToPdf\Tetitulz.Pdf.DocxToPdf.csproj" />
    <ProjectReference Include="..\..\src\tetitulz.pdf\Tetitulz.Pdf.Core\Tetitulz.Pdf.Core.csproj" />
    <!-- Test-only: PublicApiSnapshot renders and compares this package's exported surface against
         tests/ApiSnapshots/Tetitulz.Pdf.DocxToPdf.txt. -->
    <ProjectReference Include="..\Tetitulz.Pdf.TestHelpers\Tetitulz.Pdf.TestHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
