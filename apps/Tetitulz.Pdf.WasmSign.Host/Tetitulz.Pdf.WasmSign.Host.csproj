<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Serves Tetitulz.Pdf.WasmSign and relays RFC 3161 requests to one fixed TSA. The relay exists
    because no public TSA answers a CORS preflight (measured 2026-10-14: DigiCert, Sectigo, SSL.com,
    Certum, FreeTSA, Apple), so a page cannot reach one directly.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tetitulz.Pdf.WasmSign.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tetitulz.Pdf.WasmSign\Tetitulz.Pdf.WasmSign.csproj" />
  </ItemGroup>

</Project>
