<Window x:Class="Tetitulz.Pdf.WpfViewer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Tetitulz PDF Viewer" Height="620" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="Tetitulz" FontSize="36" FontFamily="Segoe UI Light" Foreground="#0078D4" HorizontalAlignment="Center"/>
            <TextBlock Text="PDF Viewer" FontSize="16" FontFamily="Segoe UI" Foreground="#667788" HorizontalAlignment="Center"/>
            <Border Height="2" Width="50" CornerRadius="1" Margin="0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0078D4" Offset="0"/>
                        <GradientStop Color="#00BCF2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Text="Version 1.0.0" FontSize="12" Foreground="#8899AA" HorizontalAlignment="Center"/>
            <TextBlock Text="Pure .NET PDF Library" FontSize="11" Foreground="#8899AA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Copyright -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#999" Opacity="0.12"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Copyright" FontWeight="SemiBold" FontSize="13" Foreground="#333" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" LineHeight="18">
                    Copyright &#x00A9; 2026 Tetitulz. All rights reserved.
                    <LineBreak/>
                    Powered by the Tetitulz.Pdf library — a pure managed .NET PDF engine
                    with no native dependencies (no native PDF engine).
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Licenses -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#999" Opacity="0.12"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Open Source Licenses" FontWeight="SemiBold" FontSize="13" Foreground="#333" Margin="0,0,0,10"/>

                    <!-- Fluent.Ribbon -->
                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0078D4">Fluent.Ribbon 10.0.4</TextBlock>
                            <TextBlock FontSize="10" Foreground="#888">MIT License</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555" Margin="0,4,0,0">
                                Copyright (c) Bastian Schmidt. Office-style ribbon control for WPF.
                                Permission is hereby granted, free of charge, to use, copy, modify,
                                merge, publish, distribute, sublicense, and/or sell copies.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- SkiaSharp -->
                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32">SkiaSharp 4.151.0</TextBlock>
                            <TextBlock FontSize="10" Foreground="#888">MIT License</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555" Margin="0,4,0,0">
                                Copyright (c) Microsoft Corporation. Cross-platform 2D graphics
                                library powered by Google Skia. Used for PDF page rendering.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- BouncyCastle -->
                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#C62828">BouncyCastle.Cryptography 2.4.0</TextBlock>
                            <TextBlock FontSize="10" Foreground="#888">MIT License</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555" Margin="0,4,0,0">
                                Copyright (c) The Legion of the Bouncy Castle Inc.
                                Cryptographic library used for PDF encryption, decryption,
                                digital signatures, and certificate handling.
                            </TextBlock>
                        </StackPanel>
                    </Border>



                    <!-- DocumentFormat.OpenXml -->
                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#455A64">DocumentFormat.OpenXml 3.2.0</TextBlock>
                            <TextBlock FontSize="10" Foreground="#888">MIT License</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555" Margin="0,4,0,0">
                                Copyright (c) Microsoft Corporation. Open XML SDK for reading
                                and writing DOCX, XLSX, PPTX files. Used for DOCX to PDF conversion.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Jint -->
                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF8F00">Jint 4.0.0</TextBlock>
                            <TextBlock FontSize="10" Foreground="#888">BSD 2-Clause License</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555" Margin="0,4,0,0">
                                Copyright (c) Sebastien Ros. JavaScript interpreter for .NET.
                                Used for PDF JavaScript action execution.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Newtonsoft.Json -->
                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#455A64">Newtonsoft.Json 13.0.3</TextBlock>
                            <TextBlock FontSize="10" Foreground="#888">MIT License</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555" Margin="0,4,0,0">
                                Copyright (c) James Newton-King. JSON framework for .NET.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Nethereum -->
                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#455A64">Nethereum.Web3 4.27.0</TextBlock>
                            <TextBlock FontSize="10" Foreground="#888">MIT License</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555" Margin="0,4,0,0">
                                Copyright (c) Nethereum. Ethereum integration library.
                                Used for blockchain-based PDF signature verification.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Close button -->
        <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="20,8" FontSize="12" Click="Close_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1A8FE8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
