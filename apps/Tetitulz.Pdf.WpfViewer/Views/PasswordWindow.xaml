<Window x:Class="Tetitulz.Pdf.WpfViewer.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F5F7FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{Binding Prompt}" FontSize="13" Foreground="#333" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <PasswordBox x:Name="PwBox" FontSize="13" Padding="8,6" Margin="0,0,0,8"/>

        <!-- The confirmation, when a password is being set -->
        <TextBlock Text="The same password again:" FontSize="11" Foreground="#666"
                   Visibility="{Binding ShowConfirm}" Margin="0,0,0,2"/>
        <PasswordBox x:Name="PwConfirm" FontSize="13" Padding="8,6" Margin="0,0,0,8"
                     Visibility="{Binding ShowConfirm}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0" FontSize="12" IsCancel="True"/>
            <Button Content="OK" Click="OK_Click" Padding="16,6" FontSize="12" IsDefault="True"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
