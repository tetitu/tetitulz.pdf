<Fluent:RibbonWindow
        x:Class="Tetitulz.Pdf.WpfViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Fluent="urn:fluent-ribbon"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:conv="clr-namespace:Tetitulz.Pdf.WpfViewer.Converters"
        Title="{Binding Title}" Height="900" Width="1400" WindowState="Maximized"
        GlassFrameThickness="0" Background="#FFF3F3F3"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver" Closing="OnClosing">

    <Fluent:RibbonWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InvertBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:ZoomToPercentConverter x:Key="ZoomPct"/>
    </Fluent:RibbonWindow.Resources>

    <Fluent:RibbonWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCmd}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCmd}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCmd}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FindCmd}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCmd}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCmd}"/>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintCmd}"/>
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCmd}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCmd}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding FitPageCmd}"/>
        <KeyBinding Key="F11" Command="{Binding FullScreenCmd}"/>
    </Fluent:RibbonWindow.InputBindings>

    <DockPanel>
        <Fluent:Ribbon DockPanel.Dock="Top">

            <!-- HOME -->
            <Fluent:RibbonTabItem Header="Home">
                <Fluent:RibbonGroupBox Header="File">
                    <Fluent:Button Header="Open" Command="{Binding OpenCmd}" LargeIcon="{StaticResource IconOpen}" Icon="{StaticResource IconOpen}" SizeDefinition="Large" ToolTip="Open a PDF or a Word document (Ctrl+O)"/>
                    <Fluent:DropDownButton x:Name="RecentButton" Header="Recent" Icon="{StaticResource IconDocx}" SizeDefinition="Middle" DropDownOpened="OnRecentOpened"/>
                    <Fluent:Button Header="Save" Command="{Binding SaveCmd}" Icon="{StaticResource IconSave}" SizeDefinition="Middle" ToolTip="Save to the file it came from (Ctrl+S)"/>
                    <Fluent:Button Header="Save As" Command="{Binding SaveAsCmd}" SizeDefinition="Middle" ToolTip="Save to a new file (Ctrl+Shift+S)"/>
                    <Fluent:Button Header="Print" Command="{Binding PrintCmd}" SizeDefinition="Middle" ToolTip="Print every page (Ctrl+P)"/>
                    <Fluent:Button Header="Default app" Command="{Binding DefaultAppCmd}" SizeDefinition="Middle" ToolTip="Make Tetitulz PDF Viewer the app that opens PDF files (opens Windows' Default apps)"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Edit">
                    <Fluent:Button Header="Undo" Command="{Binding UndoCmd}" ToolTip="{Binding UndoText}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Redo" Command="{Binding RedoCmd}" ToolTip="{Binding RedoText}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Navigate">
                    <Fluent:Button Header="Previous" Command="{Binding PrevCmd}" Icon="{StaticResource IconPrev}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Next" Command="{Binding NextCmd}" Icon="{StaticResource IconNext}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Find" Command="{Binding FindCmd}" Icon="{StaticResource IconSearch}" SizeDefinition="Middle" ToolTip="Find text, every match highlighted on the page (Ctrl+F)"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Zoom">
                    <Fluent:Button Header="Zoom In" Command="{Binding ZoomInCmd}" Icon="{StaticResource IconZoomIn}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Zoom Out" Command="{Binding ZoomOutCmd}" Icon="{StaticResource IconZoomOut}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Fit Page" Command="{Binding FitPageCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Fit Width" Command="{Binding FitWidthCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Actual Size" Command="{Binding ActualSizeCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Continuous" Command="{Binding ContinuousScrollCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Full Screen" Command="{Binding FullScreenCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Text">
                    <Fluent:Button Header="Page Text" Command="{Binding ExtractTextCmd}" Icon="{StaticResource IconText}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Tables" Command="{Binding ExtractTablesCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- INSERT -->
            <Fluent:RibbonTabItem Header="Insert">
                <Fluent:RibbonGroupBox Header="On the page">
                    <Fluent:Button Header="Text" Command="{Binding AddTextCmd}" LargeIcon="{StaticResource IconText}" Icon="{StaticResource IconText}" SizeDefinition="Large" ToolTip="Click where the text starts"/>
                    <Fluent:Button Header="Picture" Command="{Binding InsertImageCmd}" LargeIcon="{StaticResource IconImage}" Icon="{StaticResource IconImage}" SizeDefinition="Large" ToolTip="A PNG or JPEG, dragged out where it goes"/>
                    <Fluent:Button Header="Barcode" Command="{Binding AddBarcodeCmd}" Icon="{StaticResource IconBarcode}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Stamp" Command="{Binding StampCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Link" Command="{Binding LinkCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Every page">
                    <Fluent:Button Header="Watermark" Command="{Binding WatermarkCmd}" LargeIcon="{StaticResource IconWatermark}" Icon="{StaticResource IconWatermark}" SizeDefinition="Large"/>
                    <Fluent:Button Header="Header/Footer" Command="{Binding HeaderFooterCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Files">
                    <Fluent:Button Header="Attach File" Command="{Binding AddAttachmentCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Attachments" Command="{Binding AttachmentsCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- ANNOTATE -->
            <Fluent:RibbonTabItem Header="Annotate">
                <Fluent:RibbonGroupBox Header="Markup">
                    <Fluent:Button Header="Note" Command="{Binding NoteCmd}" LargeIcon="{StaticResource IconNote}" Icon="{StaticResource IconNote}" SizeDefinition="Large" ToolTip="Click where the note goes"/>
                    <Fluent:Button Header="Highlight" Command="{Binding HighlightCmd}" LargeIcon="{StaticResource IconHighlight}" Icon="{StaticResource IconHighlight}" SizeDefinition="Large" ToolTip="Marks the selected text, or the text you drag over"/>
                    <Fluent:Button Header="Underline" Command="{Binding UnderlineCmd}" SizeDefinition="Middle" ToolTip="Marks the selected text, or the text you drag over"/>
                    <Fluent:Button Header="Strike Out" Command="{Binding StrikeOutCmd}" Icon="{StaticResource IconStrikeOut}" SizeDefinition="Middle" ToolTip="Marks the selected text, or the text you drag over"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Drawing">
                    <Fluent:Button Header="Rectangle" Command="{Binding RectangleCmd}" Icon="{StaticResource IconRect}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Text Box" Command="{Binding FreeTextCmd}" Icon="{StaticResource IconText}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- PAGES -->
            <Fluent:RibbonTabItem Header="Pages">
                <Fluent:RibbonGroupBox Header="Organize">
                    <Fluent:Button Header="Organize" Command="{Binding OrganizeCmd}" LargeIcon="{StaticResource IconMerge}" Icon="{StaticResource IconMerge}" SizeDefinition="Large" ToolTip="Reorder, turn, delete, insert and extract pages"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="This page">
                    <Fluent:Button Header="Rotate" Command="{Binding RotateCmd}" LargeIcon="{StaticResource IconRotate}" Icon="{StaticResource IconRotate}" SizeDefinition="Large"/>
                    <Fluent:Button Header="Delete" Command="{Binding DeletePageCmd}" Icon="{StaticResource IconDelete}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Insert Blank" Command="{Binding InsertPageCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Crop" Command="{Binding CropCmd}" SizeDefinition="Middle" ToolTip="Drag out the part to keep"/>
                    <Fluent:Button Header="Extract" Command="{Binding ExtractPageCmd}" SizeDefinition="Middle" ToolTip="Save this page as a file of its own"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Combine">
                    <Fluent:Button Header="Merge Files" Command="{Binding MergeCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="4-Up" Command="{Binding NUpCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- REVIEW -->
            <Fluent:RibbonTabItem Header="Review">
                <Fluent:RibbonGroupBox Header="Accessibility">
                    <Fluent:Button Header="Check" Command="{Binding A11yCheckCmd}" LargeIcon="{StaticResource IconA11y}" Icon="{StaticResource IconA11y}" SizeDefinition="Large"/>
                    <Fluent:Button Header="Fix" Command="{Binding A11yFixCmd}" Icon="{StaticResource IconRepair}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Document">
                    <Fluent:Button Header="Properties" Command="{Binding MetadataCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Bookmarks" Command="{Binding BookmarksCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Compare" Command="{Binding CompareCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Forms">
                    <Fluent:Button Header="List Fields" Command="{Binding ListFieldsCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Flatten" Command="{Binding FlattenCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- PROTECT -->
            <Fluent:RibbonTabItem Header="Protect">
                <Fluent:RibbonGroupBox Header="Signatures">
                    <Fluent:Button Header="Sign" Command="{Binding SignCmd}" LargeIcon="{StaticResource IconSign}" Icon="{StaticResource IconSign}" SizeDefinition="Large" ToolTip="Sign with a Windows or smart-card certificate, or a PFX file; drag out where it shows. A click on an empty signature field signs that field."/>
                    <Fluent:Button Header="Verify" Command="{Binding VerifyCmd}" SizeDefinition="Middle"/>
                    <Fluent:DropDownButton Header="Trust" SizeDefinition="Middle" ToolTip="Which certificates a signature must chain to, to be trusted">
                        <Fluent:MenuItem Header="Windows' trusted root certificates" Command="{Binding TrustWindowsCmd}"/>
                        <Fluent:MenuItem Header="Certificates in a folder…" Command="{Binding TrustFolderCmd}"/>
                        <Fluent:MenuItem Header="No certificate (check integrity only)" Command="{Binding TrustNoneCmd}"/>
                    </Fluent:DropDownButton>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Password">
                    <Fluent:Button Header="Encrypt" Command="{Binding EncryptCmd}" Icon="{StaticResource IconEncrypt}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Remove Password" Command="{Binding DecryptCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Redaction">
                    <Fluent:Button Header="Mark Area" Command="{Binding MarkRedactionCmd}" LargeIcon="{StaticResource IconRedact}" Icon="{StaticResource IconRedact}" SizeDefinition="Large" ToolTip="Drag over what to remove; mark as many as you need"/>
                    <Fluent:Button Header="Mark Text" Command="{Binding MarkTextRedactionCmd}" SizeDefinition="Middle" ToolTip="Mark every place a text is drawn"/>
                    <Fluent:Button Header="Clear Marks" Command="{Binding ClearRedactionsCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Apply" Command="{Binding ApplyRedactionsCmd}" SizeDefinition="Middle" ToolTip="Remove everything under the marks, for good"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Clean">
                    <Fluent:Button Header="Sanitize" Command="{Binding SanitizeCmd}" SizeDefinition="Middle" ToolTip="Remove scripts, actions and embedded files"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- CONVERT -->
            <Fluent:RibbonTabItem Header="Convert">
                <Fluent:RibbonGroupBox Header="Export">
                    <Fluent:Button Header="Word" Command="{Binding ExportDocxCmd}" LargeIcon="{StaticResource IconExport}" Icon="{StaticResource IconExport}" SizeDefinition="Large"/>
                    <Fluent:Button Header="Excel" Command="{Binding ExportExcelCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="PowerPoint" Command="{Binding ExportPptxCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="HTML" Command="{Binding ExportHtmlCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="SVG (page)" Command="{Binding ExportSvgCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Pictures" Command="{Binding ExtractImagesCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Import">
                    <Fluent:Button Header="SVG to PDF" Command="{Binding ImportSvgCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Standards">
                    <Fluent:Button Header="Check PDF/A" Command="{Binding ValidatePdfACmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Convert to PDF/A" Command="{Binding ConvertPdfACmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Check PDF/X" Command="{Binding ValidatePdfXCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="File">
                    <Fluent:Button Header="Optimize" Command="{Binding OptimizeCmd}" Icon="{StaticResource IconOptimize}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Repair" Command="{Binding RepairCmd}" Icon="{StaticResource IconRepair}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="Linearize" Command="{Binding LinearizeCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="OCR">
                    <Fluent:Button Header="This Page" Command="{Binding OcrPageCmd}" SizeDefinition="Middle"/>
                    <Fluent:Button Header="All Pages" Command="{Binding OcrDocumentCmd}" SizeDefinition="Middle"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Help">
                    <Fluent:Button Header="About" Command="{Binding AboutCmd}" SizeDefinition="Large"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <!-- STATUS BAR -->
        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem Title="Status" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Status}" FontSize="11"/>
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="Zoom" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Zoom, Converter={StaticResource ZoomPct}}" FontSize="11"/>
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>

        <!-- TEXT AND INFO -->
        <Border DockPanel.Dock="Bottom" Height="145" BorderThickness="0,1,0,0" BorderBrush="#D0D0D0" Background="#FAFBFC"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}">
            <TabControl BorderThickness="0" Background="Transparent" FontSize="11" FontFamily="Segoe UI">
                <TabItem Header="  Text  " Padding="8,3">
                    <TextBox Text="{Binding PageText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas" FontSize="10.5" BorderThickness="0" Background="Transparent" Padding="6" VerticalScrollBarVisibility="Auto"/>
                </TabItem>
                <TabItem Header="  Info  " Padding="8,3">
                    <TextBox Text="{Binding InfoText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="10.5" BorderThickness="0" Background="Transparent" Padding="6" VerticalScrollBarVisibility="Auto"/>
                </TabItem>
            </TabControl>
        </Border>

        <!-- The library's viewer control: pages, thumbnails, bookmarks, comments, forms, signatures.
             A WindowsFormsHost draws above any WPF content in its area, so the empty-state card and
             the host take turns rather than overlapping. -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6B7B8D" Offset="0"/>
                    <GradientStop Color="#4A5B6D" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <wfi:WindowsFormsHost x:Name="ViewerHost" Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="48,36" Background="White"
                    Visibility="{Binding IsOpen, Converter={StaticResource InvBoolVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#3A4A5A" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Tetitulz" FontSize="42" FontFamily="Segoe UI Light" Foreground="#0078D4" HorizontalAlignment="Center"/>
                    <TextBlock Text="PDF Viewer" FontSize="18" Foreground="#667788" HorizontalAlignment="Center" Margin="0,2,0,16"/>
                    <TextBlock Text="Open a PDF or a Word document to begin" FontSize="13" Foreground="#8899AA" HorizontalAlignment="Center"/>
                    <Button Content="Open file…" Command="{Binding OpenCmd}" Background="#0078D4" Foreground="White"
                            BorderThickness="0" Padding="18,8" Margin="0,14,0,4" FontSize="12" Cursor="Hand" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ctrl+O, or drag a file here" FontSize="11" Foreground="#8899AA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Fluent:RibbonWindow>
