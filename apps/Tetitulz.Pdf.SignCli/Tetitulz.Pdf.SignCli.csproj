<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- One source, two builds: net48 shows the library's netstandard2.0 build serving a .NET
         Framework host; net10.0 is the same tool on the current runtime. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Tetitulz.Pdf.SignCli</RootNamespace>
    <AssemblyName>tetitulz-sign</AssemblyName>
    <AssemblyName Condition="'$(TargetFramework)' == 'net10.0'">tetitulz-sign10</AssemblyName>
    <Description>Console tool that signs an existing PDF with a PFX certificate, or verifies the signatures a PDF carries, using Tetitulz.Pdf.Core, Signing and Encryption: tetitulz-sign on .NET Framework 4.8, tetitulz-sign10 on .NET 10.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- A developer-local helper script, copied beside the app where the checkout has it. -->
    <None Include="sign-with-png.bat" CopyToOutputDirectory="PreserveNewest" Condition="Exists('sign-with-png.bat')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\tetitulz.pdf\Tetitulz.Pdf.Core\Tetitulz.Pdf.Core.csproj" />
    <ProjectReference Include="..\..\src\tetitulz.pdf\Tetitulz.Pdf.Signing\Tetitulz.Pdf.Signing.csproj" />
    <!-- Verifies an encrypted document's signatures under its password. -->
    <ProjectReference Include="..\..\src\tetitulz.pdf\Tetitulz.Pdf.Encryption\Tetitulz.Pdf.Encryption.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tetitulz.Pdf.SignCli.Tests" />
  </ItemGroup>

</Project>
