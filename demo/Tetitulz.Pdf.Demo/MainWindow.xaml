<Window x:Class="Tetitulz.Pdf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tetitulz.Pdf Demo" Height="780" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="8,8,8,4">

            <!-- DOCX to PDF Tab -->
            <TabItem Header="DOCX → PDF">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Input DOCX">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseDocxInput_Click"
                                        Style="{StaticResource ActionButton}"/>
                                <TextBox x:Name="DocxInputPath" Style="{StaticResource PathBox}"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Conversion Engine">
                            <StackPanel>
                                <RadioButton x:Name="DocxEngineBuiltIn" Content="Built-in (custom renderer)" IsChecked="True" Margin="4" Checked="DocxEngine_Checked"/>
                                <RadioButton x:Name="DocxEngineLibreOffice" Content="LibreOffice (soffice)" Margin="4" Checked="DocxEngine_Checked"/>
                                <RadioButton x:Name="DocxEngineMsWord" Content="Microsoft Word (COM)" Margin="4" Checked="DocxEngine_Checked"/>
                                <DockPanel x:Name="LibreOfficePathRow" Margin="4,8,4,4" Visibility="Collapsed">
                                    <TextBlock Text="LibreOffice Path (optional):" VerticalAlignment="Center" Width="180"/>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseLibreOfficePath_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="LibreOfficePathBox" Margin="4,0"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Output">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseDocxOutput_Click"
                                        Style="{StaticResource ActionButton}"/>
                                <TextBox x:Name="DocxOutputPath" Style="{StaticResource PathBox}"/>
                            </DockPanel>
                        </GroupBox>

                        <Button Content="Convert DOCX to PDF" Click="ConvertDocxToPdf_Click"
                                Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                Background="#0078D4" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- HTML to PDF Tab -->
            <TabItem Header="HTML → PDF">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Source">
                            <StackPanel>
                                <RadioButton x:Name="HtmlSourceFile" Content="HTML File" IsChecked="True" Margin="4" Checked="HtmlSource_Checked"/>
                                <RadioButton x:Name="HtmlSourceUrl" Content="URL" Margin="4" Checked="HtmlSource_Checked"/>
                                <RadioButton x:Name="HtmlSourceRaw" Content="Raw HTML" Margin="4" Checked="HtmlSource_Checked"/>

                                <DockPanel Margin="4,8,4,4">
                                    <Button x:Name="HtmlBrowseBtn" DockPanel.Dock="Right" Content="Browse..." Click="BrowseHtmlInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="HtmlInputBox" Margin="4,0"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Browser Engine">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HtmlEngineChromium" Content="Chromium" IsChecked="True" Margin="8,4"/>
                                <RadioButton x:Name="HtmlEngineFirefox" Content="Firefox" Margin="8,4"/>
                                <RadioButton x:Name="HtmlEngineWebKit" Content="WebKit" Margin="8,4"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Output">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseHtmlOutput_Click"
                                        Style="{StaticResource ActionButton}"/>
                                <TextBox x:Name="HtmlOutputPath" Style="{StaticResource PathBox}"/>
                            </DockPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install Browsers" Click="InstallBrowsers_Click"
                                    Style="{StaticResource ActionButton}"/>
                            <Button Content="Convert to PDF" Click="ConvertHtmlToPdf_Click"
                                    Style="{StaticResource ActionButton}"
                                    Background="#0078D4" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PDF Operations Tab -->
            <TabItem Header="Merge / Split / Optimize">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- Merge -->
                        <GroupBox Header="Merge PDFs">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Add Files..." Click="MergeAddFiles_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <ListBox x:Name="MergeFileList" Height="80" Margin="4"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseMergeOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="MergeOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Merge" Click="MergePdfs_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Clear List" Click="MergeClear_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Split -->
                        <GroupBox Header="Split PDF">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSplitInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="SplitInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSplitOutputDir_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="SplitOutputDir" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Range (from/to page, optional):" VerticalAlignment="Center" Width="210"/>
                                    <TextBox x:Name="SplitRangeFrom" Width="50" Text="" Margin="4,0"/>
                                    <TextBlock Text="–" VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBox x:Name="SplitRangeTo" Width="50" Text="" Margin="4,0"/>
                                </StackPanel>
                                <Button Content="Split into Pages" Click="SplitPdf_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Optimize -->
                        <GroupBox Header="Optimize PDF">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseOptimizeInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="OptimizeInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseOptimizeOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="OptimizeOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <CheckBox x:Name="OptCompressStreams" Content="Compress Streams" IsChecked="True" Margin="4"/>
                                    <CheckBox x:Name="OptRemoveDuplicates" Content="Remove Duplicates" IsChecked="True" Margin="4"/>
                                    <CheckBox x:Name="OptRemoveUnused" Content="Remove Unused" IsChecked="True" Margin="4"/>
                                    <CheckBox x:Name="OptRemoveMetadata" Content="Remove Metadata" Margin="4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <CheckBox x:Name="OptImageOptEnabled" Content="Optimize Images" Margin="4"/>
                                    <TextBlock Text="JPEG Quality:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox x:Name="OptImageQuality" Text="75" Width="40" Margin="4,0"/>
                                    <ComboBox x:Name="OptImagePreset" Width="120" Margin="8,0" SelectedIndex="0">
                                        <ComboBoxItem Content="Custom"/>
                                        <ComboBoxItem Content="Web Preset"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="Print Preset"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Content="Optimize" Click="OptimizePdf_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- N-up -->
                        <GroupBox Header="N-up Imposition (multiple pages per sheet)">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseNupInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="NupInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseNupOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="NupOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Layout:" VerticalAlignment="Center" Width="60"/>
                                    <ComboBox x:Name="NupLayout" Width="100" SelectedIndex="0">
                                        <ComboBoxItem Content="2-up"/>
                                        <ComboBoxItem Content="4-up"/>
                                        <ComboBoxItem Content="6-up"/>
                                        <ComboBoxItem Content="9-up"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Content="Create N-up" Click="CreateNup_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Extract Tab -->
            <TabItem Header="Extract">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- Extract Text -->
                        <GroupBox Header="Extract Text">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseExtractTextInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="ExtractTextInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Extract All Text" Click="ExtractText_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Extract Structured Text" Click="ExtractStructuredText_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Search Text -->
                        <GroupBox Header="Search Text">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSearchInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="SearchInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Query:" VerticalAlignment="Center" Width="60"/>
                                    <TextBox x:Name="SearchQuery" Width="300" Margin="4,0"/>
                                    <CheckBox x:Name="SearchIgnoreCase" Content="Ignore Case" IsChecked="True" Margin="8,0"/>
                                </StackPanel>
                                <Button Content="Search" Click="SearchText_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Extract Images -->
                        <GroupBox Header="Extract Images">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseExtractImagesInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="ExtractImagesInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseExtractImagesOutputDir_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="ExtractImagesOutputDir" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Extract Images" Click="ExtractImages_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Table Extraction -->
                        <GroupBox Header="Extract Tables">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseTableInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="TableInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Extract Tables (log results)" Click="ExtractTables_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Rendering Tab -->
            <TabItem Header="Rendering">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Input PDF">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseRenderInput_Click"
                                        Style="{StaticResource ActionButton}" Padding="8,4"/>
                                <TextBox x:Name="RenderInputPath" Style="{StaticResource PathBox}"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Render Page to PNG">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Page (0-based):" VerticalAlignment="Center" Width="120"/>
                                    <TextBox x:Name="RenderPageIndex" Width="60" Text="0" Margin="4,0"/>
                                    <TextBlock Text="DPI:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBox x:Name="RenderDpi" Width="60" Text="150" Margin="4,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Render Page → PNG" Click="RenderPageToPng_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Render All Pages → PNG" Click="RenderAllPagesToPng_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Render Page to SVG">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Page (0-based):" VerticalAlignment="Center" Width="120"/>
                                    <TextBox x:Name="RenderSvgPageIndex" Width="60" Text="0" Margin="4,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Render Page → SVG" Click="RenderPageToSvg_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Render All Pages → SVG" Click="RenderAllPagesToSvg_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="PDF to HTML">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowsePdfToHtmlInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="PdfToHtmlInput" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Convert to HTML (save to folder)" Click="ConvertPdfToHtml_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Content Editing Tab -->
            <TabItem Header="Content &amp; Pages">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Input PDF">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseContentInput_Click"
                                        Style="{StaticResource ActionButton}" Padding="8,4"/>
                                <TextBox x:Name="ContentInputPath" Style="{StaticResource PathBox}"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Watermark">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Text:" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="WatermarkText" Width="200" Text="CONFIDENTIAL" Margin="4,0"/>
                                    <TextBlock Text="Opacity:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox x:Name="WatermarkOpacity" Width="50" Text="0.3" Margin="4,0"/>
                                </StackPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse Output..." Click="BrowseWatermarkOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="WatermarkOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Add Watermark" Click="AddWatermark_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Header / Footer">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Header:" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="HeaderText" Width="300" Text="My Document — {page}" Margin="4,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Footer:" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="FooterText" Width="300" Text="Page {page}" Margin="4,0"/>
                                </StackPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse Output..." Click="BrowseHeaderFooterOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="HeaderFooterOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Add Header / Footer" Click="AddHeaderFooter_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Rotate / Delete Page">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Page index (0-based):" VerticalAlignment="Center" Width="160"/>
                                    <TextBox x:Name="PageManipIndex" Width="60" Text="0" Margin="4,0"/>
                                    <TextBlock Text="Rotation°:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <ComboBox x:Name="RotationAngle" Width="70" Margin="4,0" SelectedIndex="1">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="90"/>
                                        <ComboBoxItem Content="180"/>
                                        <ComboBoxItem Content="270"/>
                                    </ComboBox>
                                </StackPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse Output..." Click="BrowsePageManipOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="PageManipOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Rotate Page" Click="RotatePage_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Delete Page" Click="DeletePage_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Document Info">
                            <StackPanel>
                                <Button Content="Get Page Count" Click="GetPageCount_Click"
                                        Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
                                <Button Content="Get Metadata" Click="GetMetadata_Click"
                                        Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
                                <Button Content="Get Bookmarks" Click="GetBookmarks_Click"
                                        Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Attachments">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="List Attachments" Click="ListAttachments_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Attach file:" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="AttachFilePath" Width="220" Margin="4,0"/>
                                    <Button Content="Browse..." Click="BrowseAttachFile_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                </StackPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse Output..." Click="BrowseAttachOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="AttachOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Add Attachment" Click="AddAttachment_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Digital Signing Tab -->
            <TabItem Header="Digital Signing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- Sign with Certificate -->
                        <GroupBox Header="Sign with Certificate (.pfx)">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Input PDF:" VerticalAlignment="Center" Width="110"/>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSignInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="SignInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <TextBlock Text="Output PDF:" VerticalAlignment="Center" Width="110"/>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSignOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="SignOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Certificate (.pfx):" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="SignCertPath" Width="240" Margin="4,0"/>
                                    <Button Content="Browse..." Click="BrowseSignCert_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Cert Password:" VerticalAlignment="Center" Width="110"/>
                                    <PasswordBox x:Name="SignCertPassword" Width="200" Margin="4,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Reason:" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="SignReason" Width="200" Margin="4,0" Text="Document approval"/>
                                    <TextBlock Text="Location:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox x:Name="SignLocation" Width="150" Margin="4,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="TSA URL (optional):" VerticalAlignment="Center" Width="140"/>
                                    <TextBox x:Name="SignTsaUrl" Width="300" Margin="4,0"/>
                                </StackPanel>
                                <Button Content="Sign PDF" Click="SignPdf_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Verify Signatures -->
                        <GroupBox Header="Verify Signatures">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseVerifyInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="VerifyInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Verify Signatures" Click="VerifySignatures_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="List Signature Fields" Click="GetSignatures_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Add Document Timestamp -->
                        <GroupBox Header="Add Document Timestamp (RFC 3161)">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Input PDF:" VerticalAlignment="Center" Width="110"/>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseTimestampInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="TimestampInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <TextBlock Text="Output PDF:" VerticalAlignment="Center" Width="110"/>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseTimestampOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="TimestampOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="TSA URL:" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="TimestampTsaUrl" Width="380" Margin="4,0"
                                             Text="http://timestamp.digicert.com"/>
                                </StackPanel>
                                <Button Content="Add Document Timestamp" Click="AddDocumentTimestamp_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Blockchain Signature (Ethereum) -->
                        <GroupBox Header="Blockchain Signature (Ethereum)">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Input PDF:" VerticalAlignment="Center" Width="110"/>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseBlockchainInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="BlockchainInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <TextBlock Text="Output PDF:" VerticalAlignment="Center" Width="110"/>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseBlockchainOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="BlockchainOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Certificate (.pfx):" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="BlockchainCertPath" Width="200"/>
                                    <Button Content="Browse..." Click="BrowseBlockchainCert_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Cert Password:" VerticalAlignment="Center" Width="110"/>
                                    <PasswordBox x:Name="BlockchainCertPassword" Width="200"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="RPC URL:" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="BlockchainRpcUrl" Width="350" Text="http://localhost:8545"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Private Key:" VerticalAlignment="Center" Width="110"/>
                                    <PasswordBox x:Name="BlockchainPrivateKey" Width="350"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Chain ID:" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="BlockchainChainId" Width="80" Text="11155111"/>
                                </StackPanel>
                                <TextBlock x:Name="BlockchainStatus" Margin="4" Text="Ready"/>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Sign + Record on Blockchain" Click="BlockchainSign_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Verify Blockchain Proof" Click="BlockchainVerify_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Validation Tab -->
            <TabItem Header="Validation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Input PDF">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseValidateInput_Click"
                                        Style="{StaticResource ActionButton}" Padding="8,4"/>
                                <TextBox x:Name="ValidateInputPath" Style="{StaticResource PathBox}"/>
                            </DockPanel>
                        </GroupBox>

                        <!-- PDF/A -->
                        <GroupBox Header="PDF/A (ISO 19005)">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Conformance:" VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="PdfAConformance" Width="100" SelectedIndex="0">
                                        <ComboBoxItem Content="1b"/>
                                        <ComboBoxItem Content="2b"/>
                                        <ComboBoxItem Content="3b"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Validate PDF/A" Click="ValidatePdfA_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Convert to PDF/A" Click="ConvertToPdfA_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse Output..." Click="BrowsePdfAOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="PdfAOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- PDF/UA -->
                        <GroupBox Header="PDF/UA (ISO 14289) — Accessibility">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="Validate PDF/UA" Click="ValidatePdfUa_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button Content="Fix Accessibility" Click="FixAccessibility_Click"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse Output..." Click="BrowsePdfUaOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="PdfUaOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- PDF/X -->
                        <GroupBox Header="PDF/X (ISO 15930) — Print Production">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Standard:" VerticalAlignment="Center" Width="70"/>
                                    <ComboBox x:Name="PdfXStandard" Width="110" SelectedIndex="0">
                                        <ComboBoxItem Content="PDF/X-1a"/>
                                        <ComboBoxItem Content="PDF/X-3"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Content="Validate PDF/X" Click="ValidatePdfX_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Repair -->
                        <GroupBox Header="Repair Malformed PDF">
                            <StackPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse Output..." Click="BrowseRepairOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="RepairOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Repair PDF" Click="RepairPdf_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PDF Security Tab -->
            <TabItem Header="Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- Encrypt -->
                        <GroupBox Header="Set Password / Encrypt">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseEncryptInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="EncryptInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseEncryptOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="EncryptOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="User Password:" VerticalAlignment="Center" Width="110"/>
                                    <PasswordBox x:Name="EncryptUserPassword" Width="200" Margin="4,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Owner Password:" VerticalAlignment="Center" Width="110"/>
                                    <PasswordBox x:Name="EncryptOwnerPassword" Width="200" Margin="4,0"/>
                                </StackPanel>
                                <Button Content="Encrypt PDF" Click="EncryptPdf_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Decrypt -->
                        <GroupBox Header="Remove Password / Decrypt">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseDecryptInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="DecryptInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseDecryptOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="DecryptOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Password:" VerticalAlignment="Center" Width="110"/>
                                    <PasswordBox x:Name="DecryptPassword" Width="200" Margin="4,0"/>
                                </StackPanel>
                                <Button Content="Decrypt PDF" Click="DecryptPdf_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Sanitize -->
                        <GroupBox Header="Sanitize PDF (remove JS, embedded files)">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSanitizeInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="SanitizeInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSanitizeOutput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="SanitizeOutputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <Button Content="Sanitize" Click="SanitizePdf_Click"
                                        Style="{StaticResource ActionButton}"
                                        Background="#0078D4" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Brute Force Password Finder -->
                        <GroupBox Header="Brute Force Password Finder">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseBruteForceInput_Click"
                                            Style="{StaticResource ActionButton}" Padding="8,4"/>
                                    <TextBox x:Name="BruteForceInputPath" Style="{StaticResource PathBox}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Characters:" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="BruteForceCharset" Width="300" Text="0123456789abcdefghijklmnopqrstuvwxyz"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Min Length:" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="BruteForceMinLen" Width="50" Text="1"/>
                                    <TextBlock Text="Max Length:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="BruteForceMaxLen" Width="50" Text="6" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="Threads:" VerticalAlignment="Center" Width="110"/>
                                    <TextBox x:Name="BruteForceThreads" Width="50" Text="4"/>
                                </StackPanel>
                                <ProgressBar x:Name="BruteForceProgress" Height="20" Margin="4"/>
                                <TextBlock x:Name="BruteForceStatus" Margin="4" Text="Ready"/>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button x:Name="BruteForceStartBtn" Content="Start" Click="BruteForceStart_Click"
                                            Style="{StaticResource ActionButton}"
                                            Background="#0078D4" Foreground="White"/>
                                    <Button x:Name="BruteForcePauseBtn" Content="Pause" Click="BruteForcePause_Click"
                                            Style="{StaticResource ActionButton}" IsEnabled="False"/>
                                    <Button x:Name="BruteForceStopBtn" Content="Stop" Click="BruteForceStop_Click"
                                            Style="{StaticResource ActionButton}" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Global busy progress bar (indeterminate, thin) -->
        <ProgressBar x:Name="GlobalProgress" Grid.Row="1" IsIndeterminate="True"
                     Visibility="Collapsed" Margin="0" Height="6"/>

        <!-- Log Panel -->
        <TextBox x:Name="LogOutput" Grid.Row="2" Style="{StaticResource LogBox}"
                 Text="Ready. Select an operation above to begin."/>
    </Grid>
</Window>
