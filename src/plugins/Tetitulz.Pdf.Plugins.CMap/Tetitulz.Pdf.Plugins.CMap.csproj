<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      netstandard2.0 alongside net10.0 so .NET Framework hosts can use this plugin. It references
      only Core/Base, which already ship that leg, and needed no source change.
    -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Description>Adobe predefined CMap data for Tetitulz.Pdf. Mechanism lives in Core; this package carries the embedded CMap payload and registers it, so CJK encodings resolve without bloating the core package.</Description>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tetitulz.Pdf.Plugins.CMap</RootNamespace>
    <AssemblyName>Tetitulz.Pdf.Plugins.CMap</AssemblyName>
    <!-- Adobe CMap resources are embedded so no external download is needed at runtime. -->
    <!-- License: BSD 3-Clause — see LICENSE.md (copyright 1990-2023 Adobe). -->
    <PackageLicenseExpression>Apache-2.0 AND BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="Tetitulz.Pdf.Core.Plugins.PdfPluginAssemblyAttribute" />
  </ItemGroup>
  <!-- Embed all CMap files from the four Adobe collections as assembly resources. -->
  <ItemGroup>
    <EmbeddedResource Include="CMapResources\**\*" />
  </ItemGroup>
  <!--
    The Adobe CMap resources are embedded into this assembly, so the BSD 3-Clause notice must
    travel with the binary — it is packed into the .nupkg, not left behind as a repo-only file.
    (Packed under a distinct name so it is not confused with the package's own LICENSE, the
    Apache-2.0 text; the expression above names both.)
  -->
  <ItemGroup>
    <None Include="LICENSE.md" Pack="true" PackagePath="LICENSE-Adobe-CMap.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tetitulz.pdf\Tetitulz.Pdf.Core\Tetitulz.Pdf.Core.csproj" />
  </ItemGroup>
</Project>
