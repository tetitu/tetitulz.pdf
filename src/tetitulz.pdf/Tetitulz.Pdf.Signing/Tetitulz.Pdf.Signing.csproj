<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Description>Digital signatures for Tetitulz.Pdf: CMS and PAdES signing and verification, deferred (two-phase) signing for remote signers and HSMs, RFC 3161 timestamps, DSS/LTV evidence and DocMDP.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tetitulz.Pdf.Signing</RootNamespace>
    <AssemblyName>Tetitulz.Pdf.Signing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Portable.BouncyCastle" ExcludeAssets="compile;runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tetitulz.Pdf.Core\Tetitulz.Pdf.Core.csproj" />
  </ItemGroup>

  <!--
    PdfSigningOperations, ISignPlugin and ISignatureVerifyPlugin were compiled OUT of the
    netstandard2.0 target, silently removing 12 public members from any .NET Framework consumer
    with no #error or [Obsolete] to explain the hole. The stated reason — "requires PdfPluginHost
    (SDK, net10.0 only)" — was already stale: Plugins.SDK multi-targeted net10.0;netstandard2.0.
    The plugin contracts now live in Tetitulz.Pdf.Core (same TFMs as this project), so the
    condition is gone and both targets expose the identical API surface.
  -->

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tetitulz.Pdf.Base</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tetitulz.Pdf.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tetitulz.Pdf.Base.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tetitulz.Pdf.Plugins.SignatureVerify</_Parameter1>
    </AssemblyAttribute>
    <!-- Encryption -> Signing is the sanctioned reference that lets an encrypted document be
         signed (CLAUDE.md, "Encryption"). What crosses is SignaturePlan, and one member of it is
         internal on purpose: CmsPostProcessor hands a caller the finished CMS before it is written,
         which is exactly the hook ISO/TS 32004 §6.5.2 needs and exactly the hook nobody outside
         this library should have - it can replace a signature wholesale. Internal plus this line
         gives the one partner assembly access without making it API. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tetitulz.Pdf.Encryption</_Parameter1>
    </AssemblyAttribute>
    <!-- This assembly's own test project. CertificateChainValidator is internal, and the
         certificate-ordering behaviour it now has can only be driven deterministically by handing
         it a store whose order the test controls - through a signed PDF, the CMS bag order is
         BouncyCastle's to choose, so the test would pass or fail by luck. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tetitulz.Pdf.Signing.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>